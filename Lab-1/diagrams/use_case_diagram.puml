@startuml

left to right direction

' =========================
' ACTORS
' =========================

actor Student
actor "Academic Registrar" as Registrar
actor "Timetable System" as Timetable


' =========================
' SYSTEM
' =========================

rectangle "Academic Elective Bidding & Allocation System" {

    usecase "View Available Electives" as UC1
    usecase "Submit Bids" as UC2
    usecase "Check Prerequisites" as UC3
    usecase "Check Timetable Conflicts" as UC4
    usecase "Allocate Electives" as UC5
    usecase "View Final Allocation" as UC6

}


' =========================
' ACTOR RELATIONSHIPS
' =========================

Student --> UC1
Student --> UC2
Student --> UC6

Registrar --> UC5
Registrar --> UC1

Timetable --> UC4


' =========================
' INCLUDE RELATIONSHIP
' =========================

UC2 ..> UC3 : <<include>>


' =========================
' EXTEND RELATIONSHIP
' =========================

UC4 ..> UC2 : <<extend>>


@enduml
